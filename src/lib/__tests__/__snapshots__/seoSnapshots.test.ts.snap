exports[`SEO serialized output snapshots > root JSON-LD graph is stable 1`] = `
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": "https://careermonke.com/#organization",
      "@type": "Organization",
      "logo": "https://careermonke.com/careermonke-logo.png",
      "name": "CareerMonke",
      "url": "https://careermonke.com",
    },
    {
      "@id": "https://careermonke.com/#website",
      "@type": "WebSite",
      "name": "CareerMonke",
      "potentialAction": {
        "@type": "SearchAction",
        "query-input": "required name=search_term_string",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://careermonke.com/jobs?q={search_term_string}",
        },
      },
      "publisher": {
        "@id": "https://careermonke.com/#organization",
      },
      "url": "https://careermonke.com",
    },
  ],
}
`;

