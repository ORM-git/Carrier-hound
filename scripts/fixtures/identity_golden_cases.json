{
  "version": "v2",
  "contract": "length_framed_utf8_sha256",
  "description": "Language-neutral golden test vectors for job identity and similarity hashing",
  "cases": [
    {
      "id": "case_01_paypay_japanese_roles",
      "name": "PayPay Unrelated Japanese Roles",
      "description": "Preserves Japanese characters so unrelated roles do not collide and expire rows",
      "items": [
        {
          "label": "Product Manager",
          "input": {
            "company": "PayPay Inc.",
            "title": "プロダクトマネージャー",
            "country": "JP",
            "location": "東京都, 日本"
          },
          "expected_payload": "v2|c:6:paypay|t:33:プロダクトマネージャー|co:2:jp|loc:9:東京都",
          "expected_hash": "47a1e880aad0f529ae7f12a56e1ffe02b2b4b3679bc4ee43fde06b126f3c0cfe"
        },
        {
          "label": "Backend Engineer",
          "input": {
            "company": "PayPay Inc.",
            "title": "バックエンドエンジニア",
            "country": "JP",
            "location": "東京都, 日本"
          },
          "expected_payload": "v2|c:6:paypay|t:33:バックエンドエンジニア|co:2:jp|loc:9:東京都",
          "expected_hash": "378c114d9186654e22a7140e7202f81f01bd2c0e44ffc280c87d96c9a9c6de6b"
        }
      ],
      "expected_outcome": "distinct_hashes"
