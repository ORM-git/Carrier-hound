      "items": [
        {
          "label": "NFD Decomposed (e + acute)",
          "input": {
            "company": "Café Inc",
            "title": "Barista",
            "country": "FR",
            "location": "Nice"
          },
          "expected_payload": "v2|c:5:café|t:7:barista|co:2:fr|loc:4:nice",
          "expected_hash": "50d4f87149f90cde2f8467cbd2c719186b816f36283412098e25f1578ef08df0"
        },
        {
          "label": "NFC Pre-composed (é)",
          "input": {
            "company": "Café Ltd",
            "title": "Barista",
            "country": "FR",
            "location": "Nice"
          },
          "expected_payload": "v2|c:5:café|t:7:barista|co:2:fr|loc:4:nice",
          "expected_hash": "50d4f87149f90cde2f8467cbd2c719186b816f36283412098e25f1578ef08df0"
        }
      ],
      "expected_outcome": "identical_hashes"
