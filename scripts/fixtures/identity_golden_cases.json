    {
      "id": "case_09_delimiter_characters_injection",
      "name": "Delimiter Characters Injection Safety",
      "description": "Values containing length-framing or delimiter characters (| and :) do not shift framing or collide",
      "items": [
        {
          "label": "Pipe and Colon in title and company",
          "input": {
            "company": "A | B : C",
            "title": "Staff Engineer | Platform : Core",
            "country": "US",
            "location": "Austin | Remote"
          },
          "expected_payload": "v2|c:9:a | b : c|t:32:staff engineer | platform : core|co:2:us|loc:15:austin | remote",
          "expected_hash": "950798468c6e4213e50b42ba18b3b5c987b288ccde080a0023a0e7b2b2c19c85"
        },
        {
          "label": "Different structure with similar tokens",
          "input": {
            "company": "A",
            "title": "B : C | Staff Engineer",
            "country": "US",
            "location": "Platform : Core"
          },
          "expected_payload": "v2|c:1:a|t:22:b : c | staff engineer|co:2:us|loc:15:platform : core",
          "expected_hash": "06788cdfd6ffe4c2c29b5dacdb0a355299478cfe6ebe603e7d5a48f7dd484708"
        }
      ],
      "expected_outcome": "distinct_hashes"
    },
