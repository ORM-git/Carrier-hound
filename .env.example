# ============================================================
# CareerMonke / Career Hound Environment Variables
# ============================================================

# Supabase Public API (safe for browser and frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (PRIVATE — server / ingestion pipeline / cron only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Model Strategy (Groq OpenAI-compatible endpoints - Server-only, set in Netlify Dashboard for production)
GROQ_API_KEY=your_groq_api_key_here
FAST_MODEL=openai/gpt-oss-20b
SMART_MODEL=openai/gpt-oss-120b

# Daily Automated Cron Secret
CRON_SECRET=careermonke_cron_secret_key_123

# Server-only HMAC key for the opaque companyGroupId sent to guest/free job-search responses.
# REQUIRED in production: generate a random 32+ char value, use the SAME value on Cloudflare Pages and Netlify (all environments),
# and set it BEFORE deploying. Never NEXT_PUBLIC_*; never reuse service_role or another secret. Rotating it changes every group key.
COMPANY_GROUP_ID_SECRET=

# Server-only HMAC key for job-feed page continuations (row 69, src/lib/pagination/feedSession.ts + searchKeyset.ts).
# Generate a random 32+ char value, use the SAME value on Cloudflare Pages and Netlify (all environments). Never NEXT_PUBLIC_*;
# never reuse COMPANY_GROUP_ID_SECRET, service_role or another secret. Missing/short -> page 2+ fails closed. Rotating it only
# makes open browsing sessions restart from page 1.
FEED_SESSION_SECRET=

# Billing — Razorpay, flat one-time prepaid plans (source of truth: src/config/plans.ts PLAN_PRICING)
# Weekly ₹399 for 7 days, Monthly ₹499 for 30 days, Quarterly ₹2,199 for 90 days. No auto-renewal.
NEXT_PUBLIC_BILLING_ENABLED=true
NEXT_PUBLIC_AUTORENEW_ENABLED=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
# Auto-renew (only used when NEXT_PUBLIC_AUTORENEW_ENABLED=true): Razorpay plan IDs created in the dashboard.
# Each is checked against Razorpay before use (src/lib/billing/autorenewPlans.ts):
#   WEEKLY    39900 paise INR, period weekly,  interval 1
#   MONTHLY   49900 paise INR, period monthly, interval 1
#   QUARTERLY 219900 paise INR, period monthly, interval 3
RAZORPAY_AUTORENEW_PLAN_WEEKLY=
RAZORPAY_AUTORENEW_PLAN_MONTHLY=
RAZORPAY_AUTORENEW_PLAN_QUARTERLY=

# Early Access Mailer (Google Apps Script Web App — sends subscriber thank-you & daily owner digest)
APPS_SCRIPT_MAIL_URL=
APPS_SCRIPT_MAIL_SECRET=
EARLY_ACCESS_NOTIFY_EMAIL=
