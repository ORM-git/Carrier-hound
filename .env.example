# ============================================================
# CareerMonke / Career Hound Environment Variables
# ============================================================

# Supabase Public API (safe for browser and frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (PRIVATE — server / ingestion pipeline / cron only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Model Strategy (Groq OpenAI-compatible endpoints - Server-only, set in Netlify Dashboard for production)
GROQ_API_KEY=your_groq_api_key_here
FAST_MODEL=openai/gpt-oss-20b
SMART_MODEL=openai/gpt-oss-120b

# Daily Automated Cron Secret
CRON_SECRET=careermonke_cron_secret_key_123

# Billing — Razorpay (Weekly ₹692, Monthly ₹1,499, Quarterly ₹3,999)
# Payments stay strictly OFF until live activation. Set to "true" only when ready.
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Early Access Mailer (Google Apps Script Web App — sends subscriber thank-you & daily owner digest)
APPS_SCRIPT_MAIL_URL=
APPS_SCRIPT_MAIL_SECRET=
EARLY_ACCESS_NOTIFY_EMAIL=
